# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file (it is in .gitignore).

# --- LLM: OpenRouter ---------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-sol
# auto = use OpenRouter when a key is set, otherwise a built-in offline "fake" model
# (the fake model lets you run, test and load-test everything without spending money)
LLM_MODE=auto

# --- LangSmith (tracing + evaluation) -----------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sahyog-care

# --- Memory: leave REDIS_URL empty to keep everything in RAM ------------------
# Example: redis://localhost:6379
REDIS_URL=

# --- Voice ---------------------------------------------------------------------
# edge   = Microsoft Edge neural voices (needs internet, works on Windows)
# phonon = Ollama Phonon (Apple Silicon Macs only for now)
TTS_BACKEND=edge
OLLAMA_HOST=http://localhost:11434

# --- Supabase: real sign-in (Project settings > API) ---------------------------
# The publishable key is safe to expose in the browser. NEVER put the secret/service key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Staff sign-up codes. The registration form has an "I am a" dropdown; Doctor and Front desk need the matching code,
# which the hospital gives to its own staff. Leave a code empty to switch that kind of self-registration off.
DOCTOR_SIGNUP_CODE=
FRONTDESK_SIGNUP_CODE=
# true keeps the demo personas (doctor, front desk...) usable. Set false for a real deployment.
ALLOW_DEMO_LOGIN=false

# Speech to text: whisper = on this machine (downloads ~150 MB once), browser = built-in browser service
STT_BACKEND=auto
WHISPER_MODEL=base.en

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
